{
    "name": "pegamento/pami",
    "type": "library",
    "description": "Asterisk Manager Interface (AMI) client for PHP 8.1(+) focussed on PJSIP usage, event driven, object oriented (Fork)",
    "keywords": ["asterisk","ami","client","telephony","voip","event","action","manager","monitor","pjsip"],
    "homepage": "http://github.com/Pegamento/PAMI",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Robin Peters",
            "email": "robin.peters@pegamento.nl",
            "homepage": "http://github.com/Pegamento/",
            "role": "Developer"
        },
        {
            "name": "Ruben Kremer",
            "email": "ruben.kremer@pegamento.nl",
            "homepage": "http://github.com/Pegamento/",
            "role": "Developer"
        },
        {
            "name": "Diederik de Groot",
            "email": "ddegroot@talon.nl",
            "homepage": "http://github.com/chan-sccp/",
            "role": "Developer"
        },
        {
            "name": "Marcelo Gornstein",
            "email": "marcelog@gmail.com",
            "homepage": "http://marcelog.github.com/",
            "role": "OriginalDeveloper"
        }
    ],
    "support": {
        "issues": "https://github.com/Pegamento/PAMI/issues",
        "wiki": "https://github.com/Pegamento/PAMI/wiki",
        "source": "https://github.com/Pegamento/PAMI"
    },
    "autoload": {
        "psr-4": {
            "PAMI\\": "src/PAMI"
        }
    },
    "require": {
        "php": ">=8.1",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "php-coveralls/php-coveralls": "^2.7",
        "phpmd/phpmd": "^2.15",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "marcelog/pagi": "Required only when using the AsyncAGI client (PAMI\\AsyncAgi)."
    },
    "scripts": {
        "test": "phpunit -c test/resources/phpunit.xml",
        "test-coverage": "phpunit -c test/resources/phpunit.xml --coverage-clover build/logs/clover.xml --coverage-html build/coverage-html"
    },
    "replace": {
        "dkgroot/pami": ">=2.0.1"
    }
}
